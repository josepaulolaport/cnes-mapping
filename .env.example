# PostgreSQL connection (admin user for imports/migrations)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/atlasmed_test

# Read-only MCP connection (after running sql/mcp_test_roles.sql)
CNES_DATABASE_URL=postgresql://mcp_test_reader:YOUR_READER_PASSWORD@localhost:5432/atlasmed_test?options=-csearch_path%3Dmcp_test

# CNES CSV directory (relative to project root or absolute path)
CNES_CSV_DIR=./BASE_DE_DADOS_CNES_202605
CNES_VERSION=202605
