    "key_relationships": {
      "facility_to_doctors": {
        "path": "tbEstabelecimento → rlEstabEquipeProf → tbDadosProfissionalSus",
        "description": "Find all doctors at a facility"
      },
      "facility_to_services": {
        "path": "tbEstabelecimento → rlEstabServClass → tbServicoEspecializado",
        "description": "Find facility specialties"
      },
      "facility_to_equipment": {
        "path": "tbEstabelecimento → rlEstabEquipamento → tbEquipamento",
        "description": "Find equipment at facility"
      },
      "facility_to_location": {
        "path": "tbEstabelecimento → tbMunicipio → tbEstado",
        "description": "Geographic hierarchy"
      },
      "doctor_to_specialty": {
        "path": "tbDadosProfissionalSus → rlEstabEquipeProf → CO_CBO (occupation code)",
        "description": "Find doctor's specialty"
      }
    },
    
    "sample_queries": {
      "find_active_facilities": {
        "description": "Find only ACTIVE facilities (exclude deactivated)",
        "tables_needed": [
          "tbEstabelecimento",
          "tbMotivoDesativacao"
        ],
        "filters": "(CO_MOTIVO_DESAB IS NULL OR CO_MOTIVO_DESAB = '')",
        "importance": "CRITICAL - always include this filter"
      },
      
      "find_active_doctors": {
        "description": "Find only ACTIVE doctors at a facility",
        "tables_needed": [
          "tbDadosProfissionalSus",
          "rlEstabEquipeProf"
        ],
        "filters": "CO_UNIDADE = 'X' AND (DT_DESLIGAMENTO IS NULL OR DT_DESLIGAMENTO = '')",
        "importance": "HIGH - verify doctors are still employed"
      },
      
      "renovation_opportunities": {
        "description": "Find facilities under renovation (equipment opportunity)",
        "tables_needed": [
          "tbEstabelecimento",
          "tbMotivoDesativacao"
        ],
        "filters": "CO_MOTIVO_DESAB = '03'",
        "business_value": "Facilities under renovation often need equipment upgrades"
      },
      
      "find_orthopedic_facilities": {
        "description": "Find all orthopedic clinics in São Paulo",
        "tables_needed": [
          "tbEstabelecimento",
          "rlEstabServClass",
          "tbServicoEspecializado",
          "tbMunicipio"
        ],
        "filters": "CO_SERVICO = '155' AND CO_MUNICIPIO LIKE 'SP%'"
      },
      
      "find_cardiologists": {
        "description": "Find cardiologists at Hospital X",
        "tables_needed": [
          "tbDadosProfissionalSus",
          "rlEstabEquipeProf"
        ],
        "filters": "CO_UNIDADE = 'X' AND CO_CBO LIKE '2231%' (cardiologist CBO codes)"
      },
      
      "equipment_opportunities": {
        "description": "Find facilities without MRI equipment",
        "tables_needed": [
          "tbEstabelecimento",
          "rlEstabEquipamento"
        ],
        "filters": "NOT EXISTS (equipment = MRI code)"
      },
      
      "territory_view": {
        "description": "All facilities in my territory",
        "tables_needed": [
          "tbEstabelecimento",
          "tbMunicipio",
          "tbEstado"
        ],
        "filters": "CO_MUNICIPIO IN (territory list)"
      }
    }
