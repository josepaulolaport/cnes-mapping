      "deactivation_tracking": {
        "priority": "CRITICAL",
        "description": "Track facility and professional active/inactive status",
        "tables": [
          {
            "name": "tbMotivoDesativacao202605.csv",
            "rows": 14,
            "purpose": "Deactivation reason lookup",
            "key_fields": ["CD_MOTIVO_DESAB", "DS_MOTIVO_DESAB"],
            "sales_use_cases": [
              "Filter out closed facilities",
              "Identify renovation opportunities (code 03)",
              "Avoid wasting time on permanently closed locations",
              "Understand facility closure patterns"
            ],
            "statistics": "24.5% of establishments have deactivation codes"
          }
        ],
        "implementation_notes": {
          "establishment_status": {
            "field": "CO_MOTIVO_DESAB in tbEstabelecimento",
            "active": "NULL or empty string",
            "deactivated": "Contains reason code",
            "filter_example": "WHERE (CO_MOTIVO_DESAB IS NULL OR CO_MOTIVO_DESAB = '')"
          },
          "professional_status": {
            "field": "DT_DESLIGAMENTO in rlEstabEquipeProf",
            "active": "NULL or empty string",
            "terminated": "Has date value",
            "filter_example": "WHERE (DT_DESLIGAMENTO IS NULL OR DT_DESLIGAMENTO = '')"
          },
          "key_codes": {
            "temporary_opportunities": ["03 - Under renovation"],
            "permanent_avoid": ["05 - Closed by court", "10 - Business closure"],
            "verify_status": ["06 - No updates >1 year", "08 - No updates >6 months"]
          }
        }
      },
      
