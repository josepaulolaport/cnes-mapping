      "CONSOLIDATED_LOOKUPS": {
        "new_name": "reference_data",
        "description": "Consolidated lookup/reference table for all small code tables",
        "primary_key": ["reference_type", "code"],
        "source_tables": [
          "tbTipoEstabelecimento202605.csv",
          "tbMotivoDesativacao202605.csv",
          "tbServicoEspecializado202605.csv",
          "tbEquipamento202605.csv",
          "tbConselhoClasse202605.csv",
          "tbTipoEquipamento202605.csv"
        ],
        "columns": {
          "reference_type": {
            "type": "VARCHAR(50)",
            "is_primary_key": true,
            "description": "Type of reference (facility_type, deactivation_reason, service_specialty, equipment_catalog, professional_council, equipment_category)"
          },
          "code": {
            "type": "VARCHAR(20)",
            "is_primary_key": true,
            "description": "Reference code"
          },
          "description": {
            "type": "VARCHAR(500)",
            "description": "Reference description/name"
          },
          "extra_data": {
            "type": "JSON",
            "nullable": true,
            "description": "Type-specific additional fields"
          },
          "display_order": {
            "type": "INT",
            "nullable": true,
            "description": "Sort order for display"
          },
          "is_active": {
            "type": "BOOLEAN",
            "default": true,
            "description": "Is this reference active?"
          },
          "cnes_version": {
            "type": "VARCHAR(10)",
            "description": "CNES data version (e.g., 202607)"
          },
          "updated_at": {
            "type": "TIMESTAMP",
            "description": "When this record was last updated"
          }
        }
      }
    },
    
    "naming_patterns": {
      "removed_prefixes": {
        "CO_": "Código (Code) - removed, use descriptive names or *_code suffix",
        "NO_": "Nome (Name) - removed, use *_name suffix",
        "NU_": "Número (Number) - removed, use *_number suffix",
        "DS_": "Descrição (Description) - removed, use descriptive names",
        "TP_": "Tipo (Type) - removed, use *_type suffix",
        "ST_": "Status - removed, use is_* or has_* prefixes",
        "DT_": "Data (Date) - removed, use *_date suffix",
        "IND_": "Indicador (Indicator) - removed, use is_* prefix",
        "QT_": "Quantidade (Quantity) - removed, use quantity or count",
        "SG_": "Sigla (Abbreviation) - removed, use *_code"
      },
      "new_conventions": {
        "*_id": "Identifiers for entities",
        "*_code": "Reference/lookup codes",
        "*_name": "Names of entities",
        "*_number": "Phone numbers, license numbers, etc.",
        "*_date": "Date fields",
        "is_*": "Boolean flags (is_active, is_24_7)",
        "has_*": "Boolean possession (has_internet, has_equipment)",
        "*_type": "Type classifiers",
        "*_status": "Status indicators"
      }
    },
    
    "data_type_standards": {
      "identifiers": "VARCHAR(20)",
      "codes": "VARCHAR(10)",
      "names": "VARCHAR(200)",
      "descriptions": "VARCHAR(500)",
      "urls_emails": "VARCHAR(200)",
      "phones": "VARCHAR(20)",
      "state_codes": "CHAR(2)",
      "coordinates": "DECIMAL(10,7)",
      "dates": "DATE or TIMESTAMP",
      "booleans": "BOOLEAN (not CHAR(1))",
      "integers": "INT"
    }
  }
